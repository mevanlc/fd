// Built-in matchsets compiled into fd.
//
// Select with -m/--include-matchsets or -M/--exclude-matchsets; inspect with
// --list-matchsets. Sets of the same name in the user matchset file
// (~/.config/fd/matchsets.kdl) or in --matchset-file files shadow these.

// Named vcs_meta, not vcs: in fd flag names (--no-ignore-vcs) "vcs" refers
// to VCS ignore *rules*; this set matches VCS *metadata* entries. The (f)
// clause covers git worktrees and submodules, where .git is a pointer file.
"vcs_meta" {
    (d) name literal full {
        (git) ".git"
        (subversion) ".svn"
        (mercurial) ".hg"
        (bazaar) ".bzr"
    }
    (f) name literal full {
        (git) ".git"
    }
}

"build_output" {
    (d) bash {
        (rust) "${/} == target && -f CACHEDIR.TAG"
        (gradle) """
            ${/} == build
            && [[ -f ../build.gradle.kts || -f ../build.gradle ]]
            && [[ -d reports || -d generated || -d classes || -d tmp || -d intermediates || -d outputs ]]
            """
    }
}

"cache" {
    (d) name literal full {
        (python) "__pycache__"
        (generic) ".cache"
    }
    (d) bash {
        (cachedir_tag) "-f CACHEDIR.TAG"
    }
}

"package" {
    (d) name literal full {
        (node) "node_modules"
        (python) "__pypackages__"
        (python) ".venv"
    }
}

"os_meta" {
    (f) bash {
        // macos exfat resource fork sidecar files
        (macos) "[[ ${/} == ._* ]] && [[ -e ${/#._} ]]"
    }
    (f) name literal full {
        (macos) ".DS_Store"
    }
    (d) path literal full {
        (windows) "$<vroot>/System Volume Information"
    }
}

// Trash locations across platforms. $<home>-anchored patterns only match
// relative to the user's home directory; $<vroot>-anchored patterns only
// match relative to a volume root (a mount point). A directory merely
// *named* .Trashes elsewhere in a tree is not matched.
"trash" {
    (d) path literal full {
        (macos) "$<home>/.Trash"
        (freedesktop) "$<home>/.local/share/Trash"
    }
    (d) path literal full {
        (macos) "$<vroot>/.Trashes"
        (windows) "$<vroot>/$RECYCLE.BIN"
    }
    (d) path glob full {
        (freedesktop) "$<vroot>/.Trash-*"
    }
}
