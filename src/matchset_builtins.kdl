// Built-in matchsets compiled into fd.
//
// Select with -m/--matchsets or -M/--exclude-matchsets; inspect with
// --list-matchsets. Sets of the same name in the user matchset file
// (~/.config/fd/matchsets.kdl) or in --matchset-file files shadow these.

// Named vcs_meta, not vcs: in fd flag names (--no-ignore-vcs) "vcs" refers
// to VCS ignore *rules*; this set matches VCS *metadata* entries. The (f)
// clause covers git worktrees and submodules, where .git is a pointer file.
"vcs_meta" {
    (d) name literal full {
        ".git"
        ".svn"
        ".hg"
        ".bzr"
    }
    (f) name literal full {
        ".git"
    }
}

"build_output" {
    (d) bash {
        "${/} == target && -f CACHEDIR.TAG"
        "${/} == build && [[ -f ../build.gradle.kts || -f ../build.gradle || -f ../gradle.properties ]]"
    }
}

"cache" {
    (d) name literal full {
        "__pycache__"
        ".cache"
    }
    (d) bash {
        "-f CACHEDIR.TAG"
    }
}

"package" {
    (d) name literal full {
        "node_modules"
        "__pypackages__"
        ".venv"
    }
}

"noise" {
    (f) name literal full {
        ".DS_Store"
    }
}

// Trash locations across platforms. $<home>-anchored patterns only match
// relative to the user's home directory; $<vroot>-anchored patterns only
// match relative to a volume root (a mount point). A directory merely
// *named* .Trashes elsewhere in a tree is not matched.
"trash" {
    (d) path literal full {
        "$<home>/.Trash"
        "$<home>/.local/share/Trash"
    }
    (d) path literal full {
        "$<vroot>/.Trashes"
        "$<vroot>/$RECYCLE.BIN"
        "$<vroot>/System Volume Information"
    }
    (d) path glob full {
        "$<vroot>/.Trash-*"
    }
}
