// Original pattern-set sketch, adapted to valid match-set KDL fixture syntax.

"vcs" {
    dir name literal full {
        ".git"
        ".svn"
        ".hg"
        ".bzr"
    }
}

"build_output" {
    dir bash {
        "${/} == target && -f CACHEDIR.TAG"
        "${/} == build && [[ -f ../build.gradle.kts || -f ../build.gradle || -f ../gradle.properties ]]"
    }
}

"cache" {
    dir name literal full {
        "__pycache__"
        ".cache"
    }
}

"package" {
    dir name literal full {
        "node_modules"
        "__pypackages__"
        ".venv"
    }
}

"noise" {
    file name literal full {
        ".DS_Store"
    }
}
