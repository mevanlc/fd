#!/bin/bash
# f - a thin fd wrapper: "search everything" defaults, single-letter grammar.
#
# Everything f used to implement itself is native fd now: the default
# exclusions are the built-in matchsets (vcs_meta, package, noise), -P
# forwards to --exclude-if, and 'help' option values forward to fd's
# mini-helps. Requires an fd with matchset support (--exclude-matchsets).
#
# License: MIT

fd_dbg="${F_FD_DBG:-}"

if [ -n "${F_FD_BIN:-}" ]; then
    fd_bin="$F_FD_BIN"
else
    if command -v fd >/dev/null 2>&1; then
        fd_bin="fd"
    elif command -v fdfind >/dev/null 2>&1; then
        fd_bin="fdfind"
    else
        echo "error: fd binary not found (looked for: fd, fdfind; set F_FD_BIN=/path/to/fd)" >&2
        exit 127
    fi
fi

if [[ "$fd_bin" == */* ]]; then
    if [ ! -x "$fd_bin" ]; then
        echo "error: F_FD_BIN is not executable: $fd_bin" >&2
        exit 127
    fi
elif ! command -v "$fd_bin" >/dev/null 2>&1; then
    echo "error: fd binary not found: $fd_bin (set F_FD_BIN=/path/to/fd)" >&2
    exit 127
fi

run_fd() {
    local cmd=("$fd_bin" "$@")
    if [ "$fd_dbg" = "1" ]; then
        printf '%q ' "${cmd[@]}" >&2
        printf '\n' >&2
    fi
    "${cmd[@]}"
}

files_only=0
dirs_only=0
executable_type=0
respect_gitignore=0
respect_hidden=0
non_empty=0
use_regex=1
basename_only=0
absolute_path=0
max_depth=""
single_result=0
print0=0
one_file_system=0
changed_within=""
changed_before=""
sort_expr=""
list_details=0
case_sensitive=0
fixed_strings=0
follow_links=0
show_vcs=0
show_pkg=0
extensions=()
types=()
exec_mode="" # "", "exec", "exec-batch"
exec_cmd=()
show_help=0
show_long_help=0
prune_expr=""

excludes=()
and_patterns=()
sizes=()

# Support long help in bash as '--help' (before '--' passthrough delimiter).
_rewritten_argv=()
_saw_dd=0
for _arg in "$@"; do
    if [ $_saw_dd -eq 1 ]; then
        _rewritten_argv+=("$_arg")
        continue
    fi
    if [ "$_arg" = "--" ]; then
        _saw_dd=1
        _rewritten_argv+=("$_arg")
        continue
    fi
    if [ "$_arg" = "--help" ]; then
        show_help=1
        show_long_help=1
        continue
    fi
    _rewritten_argv+=("$_arg")
done
set -- "${_rewritten_argv[@]}"

# Manual arg parsing (supports options after [pattern] [path...]).
# Note: `--` is reserved as the fd passthrough delimiter.
positional=()
passthru=()

while [ $# -gt 0 ]; do
    arg="$1"
    shift

    if [ "$arg" = "--" ]; then
        passthru=("$@")
        break
    fi

    if [[ "$arg" == -* ]] && [ "$arg" != "-" ]; then
        flag_str="${arg#-}"
        idx=0
        while [ $idx -lt ${#flag_str} ]; do
            ch="${flag_str:$idx:1}"

            case "$ch" in
                z) print0=1 ;;
                f) files_only=1 ;;
                r) dirs_only=1 ;;
                b) executable_type=1 ;;
                O) respect_hidden=1 ;;
                Q) single_result=1 ;;
                N) non_empty=1 ;;
                G) respect_gitignore=1 ;;
                C) case_sensitive=1 ;;
                g) use_regex=0 ;;
                n) basename_only=1 ;;
                a) absolute_path=1 ;;
                l) list_details=1 ;;
                L) follow_links=1 ;;
                F) fixed_strings=1 ;;
                V) show_vcs=1 ;;
                M) show_pkg=1 ;;
                m) one_file_system=1 ;;
                h) show_help=1 ;;
                d|e|t|E|w|P|A|B|R|S|x|X)
                    if [ $((idx + 1)) -lt ${#flag_str} ]; then
                        val="${flag_str:$((idx + 1))}"
                        idx=$(( ${#flag_str} - 1 ))
                    else
                        if [ $# -eq 0 ]; then
                            echo "error: -$ch requires an argument" >&2
                            echo "Usage: f [-h|--help] [options] [pattern] [path...]" >&2
                            exit 1
                        fi
                        val="$1"
                        shift
                    fi

                    case "$ch" in
                        d) max_depth="$val" ;;
                        e) extensions+=("$val") ;;
                        t) types+=("$val") ;;
                        E) excludes+=("$val") ;;
                        w) and_patterns+=("$val") ;;
                        P)
                            if [ -n "$prune_expr" ]; then
                                echo "error: -P may only be specified once" >&2
                                exit 1
                            fi
                            prune_expr="$val"
                            ;;
                        S) sizes+=("$val") ;;
                        A) changed_within="$val" ;;
                        B) changed_before="$val" ;;
                        R) sort_expr="$val" ;;
                        x) exec_mode="exec"; exec_cmd=("$val") ;;
                        X) exec_mode="exec-batch"; exec_cmd=("$val") ;;
                    esac

                    break
                    ;;
                *)
                    echo "error: unknown flag: -$ch" >&2
                    echo "Usage: f [-h|--help] [options] [pattern] [path...]" >&2
                    exit 1
                    ;;
            esac

            idx=$((idx + 1))
        done
    else
        positional+=("$arg")
    fi
done

set -- "${positional[@]}"

if [ $show_help -eq 1 ]; then
    echo "Usage: f [-h|--help] [options] [pattern] [path...]"
    echo "  -f files"
    echo "  -r directories (dir)"
    echo "  -b executables (bin)"
    echo "  -O hide dOtfiles"
    echo "  -F use Fixed strings (not regex/glob)"
    echo "  -n search only basenames"
    echo "  -a display absolute paths"
    echo "  -C Case-sensitive"
    echo "  -l list path details (like ls -l)"
    echo "  -g use Glob (default: regex)"
    echo "  -L follow symLinked directories"
    echo "  -G respect Git/.ignore rules"
    echo "  -V include Vcs metadata (.git, .svn, .hg, .bzr)"
    echo "  -M include package/Metadata dirs (node_modules, __pypackages__, .venv, .DS_Store)"
    echo "  -m stay on one filesystem (mount)"
    echo "  -N hide empty files"
    echo "  -Q print only one result (quit)"
    echo "  -z delimit results with NULs"
    echo "  -d <depth>     max search Depth"
    echo "  -e <ext>       file extension +"
    echo "  -E <glob>      Exclude +"
    echo "  -w <pat>       add required pattern +"
    echo "  -P <cond|help> prune dirs if bash [[ cond ]] is true"
    echo "  -t <type|help> file types (kinds) +"
    echo "  -S <size|help> Size filter +"
    echo "  -A <time|help> changed After (newer than)"
    echo "  -B <time|help> changed Before (older than)"
    echo "  -R <sort|help> sort by metadata"
    echo "  -x <cmnd|help> exec for each match"
    echo "  -X <cmnd|help> eXec in batches"
    echo "  -h show help"
    echo "     indicates a repeatable flag = +"

    if [ $show_long_help -eq 1 ]; then
        echo ""
        echo "-- <fd-args>   forwards <fd-args> to fd"
        echo ""
        echo "Defaults differ from fd:"
        echo "  bypass ignore rules, search hidden, search full pathnames,"
        echo "  ignore case, and exclude fd's built-in matchsets:"
        echo "    vcs_meta  .git, .svn, .hg, .bzr"
        echo "    package   node_modules, __pypackages__, .venv"
        echo "    noise     .DS_Store"
        echo ""
        echo "A 'help' value forwards to fd's cheat-sheet for that option's"
        echo "syntax (e.g. 'f -S help', 'f -P help')."
    fi

    exit 0
fi

# Build fd arguments; f's grammar is a pure remap onto native fd flags.
args=()
[ $case_sensitive -eq 1 ] && args+=(-s)
[ $case_sensitive -eq 0 ] && args+=(-i)

# Hidden/ignored defaults (include both unless flags set)
[ $respect_hidden -eq 0 ] && args+=(-H)
[ $respect_gitignore -eq 0 ] && args+=(-I)

# Follow links
[ $follow_links -eq 1 ] && args+=(-L)

# Output format
[ $print0 -eq 1 ] && args+=(--print0)
[ $list_details -eq 1 ] && args+=(--list-details)

# Full path vs basename
[ $basename_only -eq 0 ] && args+=(-p)

# Glob vs regex vs fixed strings
[ $fixed_strings -eq 1 ] && args+=(-F)
[ $fixed_strings -eq 0 ] && [ $use_regex -eq 0 ] && args+=(-g)

# Result limit
[ $single_result -eq 1 ] && args+=(-1)

# Type filters (-f/-r/-b) and explicit types (-t) combine as OR filters.
[ $files_only -eq 1 ] && types+=("f")
[ $dirs_only -eq 1 ] && types+=("d")
[ $executable_type -eq 1 ] && types+=("x")
for t in "${types[@]}"; do
    IFS=',' read -r -a split_types <<<"$t"
    for st in "${split_types[@]}"; do
        [ -n "$st" ] && args+=(-t "$st")
    done
done

[ $absolute_path -eq 1 ] && args+=(-a)

# Size filters
[ $non_empty -eq 1 ] && args+=(-S+1b)
for sz in "${sizes[@]}"; do
    args+=(-S "$sz")
done

# Depth
[ -n "$max_depth" ] && args+=(--max-depth "$max_depth")

# Time filters
[ -n "$changed_within" ] && args+=(--changed-within "$changed_within")
[ -n "$changed_before" ] && args+=(--changed-before "$changed_before")
[ -n "$sort_expr" ] && args+=(--sort "$sort_expr")

# Extension filters (-e) are repeatable.
for ext in "${extensions[@]}"; do
    args+=(-e "$ext")
done

# Exec options must come after [pattern] [path...] so fd doesn't treat them as part of <cmd>...
post_args=()
if [ -n "$exec_mode" ]; then
    if [ "$exec_mode" = "exec" ]; then
        post_args+=(-x "${exec_cmd[0]}")
    else
        post_args+=(-X "${exec_cmd[0]}")
    fi
fi

# Filesystem boundary
[ $one_file_system -eq 1 ] && args+=(--one-file-system)

# Default exclusions are fd's built-in matchsets; -V/-M opt back in.
exclude_sets=()
[ $show_vcs -eq 0 ] && exclude_sets+=(vcs_meta)
[ $show_pkg -eq 0 ] && exclude_sets+=(package noise)
if [ ${#exclude_sets[@]} -gt 0 ]; then
    args+=(--exclude-matchsets "$(IFS=,; echo "${exclude_sets[*]}")")
fi

# Excludes (-E) are glob patterns (repeatable).
for ex in "${excludes[@]}"; do
    args+=(-E "$ex")
done

# Add additional required patterns (-w)
for ap in "${and_patterns[@]}"; do
    args+=(--and "$ap")
done

# Prune condition (-P) is native now. --exclude-if (not --prune-if) matches
# old f semantics: a matching directory is hidden entirely, not just left
# untraversed. Unlike old f, the condition is also evaluated for files (in
# the parent directory's context), which only shows for basename-matching
# conditions.
[ -n "$prune_expr" ] && args+=(--exclude-if "$prune_expr")

search_pattern=""
paths=()

if [ $# -gt 0 ]; then
    search_pattern="$1"
    shift
    paths=("$@")
fi

# No pattern provided: behave like `fd` with just the selected filters.
if [ -z "$search_pattern" ]; then
    run_fd "${args[@]}" "${passthru[@]}" "${post_args[@]}"
    exit $?
fi

run_fd "${args[@]}" "${passthru[@]}" "$search_pattern" "${paths[@]}" "${post_args[@]}"
